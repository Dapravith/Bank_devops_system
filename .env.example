# ────────── Backend (apps/api) ──────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

CORS_ORIGINS=http://localhost:8080

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

DATABASE_URL=postgresql://banking:banking@localhost:5432/banking?schema=public
REDIS_URL=redis://localhost:6379

QUEUE_NAME=transaction-notification-queue
DLQ_NAME=transaction-notification-dlq
JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=5000

PARTNER_API_FAILURE_RATE=0.2
PARTNER_API_MIN_LATENCY_MS=200
PARTNER_API_MAX_LATENCY_MS=1500

JWT_AUTH_ENABLED=false
PARTNER_JWT_SECRET=change-me-in-production
PARTNER_JWT_ISSUER=banking-partner
PARTNER_JWT_AUDIENCE=banking-devops-platform

ADMIN_API_KEY=change-me-admin-key

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

OTEL_ENABLED=false
OTEL_SERVICE_NAME=banking-devops-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ────────── Frontend (apps/web) ──────────
# Browser-visible. Must be the URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
