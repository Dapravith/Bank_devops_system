  "panels": [
    {
      "datasource": "Prometheus",
      "description": "API request rate by status class.",
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "table", "calcs": ["last", "max"] }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{app=\"banking-devops-platform\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "title": "HTTP request rate (by status)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "API success rate (non-5xx).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"banking-devops-platform\",status!~\"5..\"}[5m])) / sum(rate(http_requests_total{app=\"banking-devops-platform\"}[5m]))"
        }
      ],
      "title": "Success rate (5m)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "API latency p50/p95/p99.",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"banking-devops-platform\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"banking-devops-platform\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{app=\"banking-devops-platform\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "title": "API latency (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Worker job outcomes.",
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "rate(transaction_jobs_success_total[1m])",
          "legendFormat": "success"
        },
        {
          "expr": "sum(rate(transaction_jobs_failed_total[1m]))",
          "legendFormat": "failed (terminal)"
        }
      ],
      "title": "Worker throughput",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Worker job processing latency.",
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(transaction_job_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(transaction_job_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "title": "Worker job latency",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Outbox dispatcher: pending events and dispatch lag.",
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 6,
      "targets": [
        { "expr": "outbox_pending_events", "legendFormat": "pending" },
        { "expr": "outbox_dispatch_lag_seconds", "legendFormat": "lag (s)" },
        {
          "expr": "sum(rate(outbox_events_dispatched_total[1m]))",
          "legendFormat": "dispatched/s"
        }
      ],
      "title": "Outbox dispatcher",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "DLQ totals: written and requeued.",
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 7,
      "targets": [
        { "expr": "dlq_entries_total", "legendFormat": "total" },
        { "expr": "dlq_requeued_total", "legendFormat": "requeued" }
      ],
      "title": "Dead-letter queue",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Dependency health.",
      "fieldConfig": { "defaults": { "min": 0, "max": 1 } },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 24 },
      "id": 8,
      "targets": [
        { "expr": "database_health_status", "legendFormat": "database" },
        { "expr": "redis_health_status", "legendFormat": "redis" }
      ],
      "title": "Dependency health (1 = healthy)",
      "type": "timeseries"
    }
  ],
